# ── Resova Production Environment Variables Template ──
#
# Use this reference when configuring Railway Service Variables.
# NEVER commit real values or files with production secrets.
#
# On Railway:
# - Set these in Service Settings -> Variables
# - DATABASE_URL is automatically injected when you attach the PostgreSQL plugin.
#
# ─────────────────────────────────────────────────────────────────────────────

# --- Core Application ---
# Enables production optimizations (disables interactive docs, secure logging).
APP_ENV=production

# Logging level: INFO is recommended for production.
LOG_LEVEL=INFO

# Default local port inside container (Railway overrides this dynamically).
PORT=8000

# --- Database ---
# Auto-injected by Railway when connecting the PostgreSQL plugin.
# If Railway uses postgres://, Resova automatically normalizes it to postgresql://.
DATABASE_URL=postgresql://postgres:password@host:port/railway

# --- Client Profile ---
# Path to the client's verified profile within the container.
PROFILE_PATH=config/profile.yaml

# --- AI Analysis (OpenAI) ---
# Master switch for AI evaluation (must be true for scoring).
ENABLE_AI_ANALYSIS=true

# Secret: Your OpenAI API key (format: sk-proj-...).
OPENAI_API_KEY=sk-proj-YOUR_ACTUAL_KEY_HERE

# Model used for evaluation (gpt-4o-mini is recommended for speed and low cost).
OPENAI_MODEL=gpt-4o-mini

# Daily safeguard cap on AI analyses to prevent unexpected billing.
DAILY_AI_ANALYSIS_LIMIT=100

# --- Telegram Notifications ---
# Master switch for Telegram alerts.
ENABLE_TELEGRAM=true

# Secret: Telegram Bot Token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_YOUR_ACTUAL_TOKEN_HERE

# Security: Only this Telegram User ID will receive alerts and be accepted.
TELEGRAM_ALLOWED_USER_ID=5975310413

# --- Email Alert Ingestion (Optional) ---
# Set to false unless IMAP mailbox is fully configured.
ENABLE_EMAIL_INGESTION=false
EMAIL_POLL_MODE=off
POLL_INTERVAL_SECONDS=60
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# --- Listing Poller (Public listings) ---
# MUST REMAIN FALSE in production until explicitly authorized.
ENABLE_LISTING_POLLER=false
LISTING_POLLER_ACK=false
LISTING_POLL_INTERVAL_SECONDS=60
LISTING_POLL_JITTER_SECONDS=10
MOSTAQL_LISTING_URLS=https://mostaql.com/projects
KHAMSAT_LISTING_URLS=https://khamsat.com/community/requests
USER_AGENT_CONTACT=afat7i2005@gmail.com

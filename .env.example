# Resova - environment template.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and must never be committed.
# This file contains PLACEHOLDERS ONLY - never put real secrets here.
#
# Change class:
#   [restart] = read once at startup, requires an application restart.
#   [runtime] = may be changed while the app runs (via system_settings table).
# The full reference table lives in docs/CONFIG.md (written in Step 2.9).

# --- Application ---
APP_ENV=development                       # [restart] development | production
LOG_LEVEL=INFO                            # [restart] DEBUG | INFO | WARNING | ERROR

# --- Database ---
DATABASE_URL=sqlite:///./resova.db        # [restart] portable SQLAlchemy URL; PostgreSQL later = config change only

# --- Filtering / matching ---
MIN_MATCH_SCORE=70                        # [runtime] notification threshold (scoring bands: 85 / 70 / 50)
ENABLE_MOSTAQL=true                       # [restart] priority-1 source
ENABLE_KHAMSAT=true                       # [restart] priority-2 source

# --- Email channel (client's own platform notification mailbox) ---
EMAIL_POLL_MODE=polling                   # [restart] polling | disabled
IMAP_HOST=imap.example.com                # [restart] placeholder
IMAP_USER=resova-alerts@example.com       # [restart] placeholder - dedicated mailbox, never the platform account
IMAP_PASSWORD=CHANGE_ME_PLACEHOLDER       # [restart] SECRET - placeholder only
POLL_INTERVAL_SECONDS=60                  # [restart] 30-60s range is the Phase 3 open question (see docs/OPEN_QUESTIONS.md)

# --- OpenAI (opportunity scoring) ---
OPENAI_API_KEY=sk-CHANGE_ME_PLACEHOLDER   # [restart] SECRET - placeholder only
OPENAI_MODEL=gpt-4o-mini                  # [restart] placeholder model id, confirmed in Phase 4
DAILY_AI_ANALYSIS_LIMIT=100               # [runtime] cost guard rail

# --- Telegram (notifications) ---
TELEGRAM_BOT_TOKEN=123456:CHANGE_ME       # [restart] SECRET - placeholder only
TELEGRAM_ALLOWED_USER_ID=0                # [restart] single-user bot: only this user id is accepted

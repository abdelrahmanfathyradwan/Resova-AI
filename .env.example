# Resova - environment template.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and must never be committed.
# This file contains PLACEHOLDERS ONLY - never put real secrets here.
#
# Change class:
#   [restart] = read once at startup, requires an application restart.
#   [runtime] = may be changed while the app runs (via the system_settings table).
# Full reference table: docs/CONFIG.md.

# --- Application ---
APP_ENV=development                       # [restart] development | production | test
LOG_LEVEL=INFO                            # [restart] DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Database ---
DATABASE_URL=sqlite:///./resova.db        # [restart] portable SQLAlchemy URL; PostgreSQL later = config change only

# --- Client profile ---
PROFILE_PATH=config/profile.yaml          # [restart] editable profile: tracks, keywords, thresholds

# --- Email channel (the client's OWN platform alert mailbox, with consent) ---
ENABLE_EMAIL_INGESTION=true               # [restart] master switch; when false no IMAP secret is required
ENABLE_MOSTAQL=true                       # [restart] priority-1 source
ENABLE_KHAMSAT=true                       # [restart] priority-2 source
EMAIL_POLL_MODE=polling                   # [restart] polling | off (off = no email polling, for dev/tests; manual paste is a separate Telegram channel)
POLL_INTERVAL_SECONDS=60                  # [restart] 30-3600; 30-60s is recommended
IMAP_HOST=imap.example.com                # [restart] placeholder
IMAP_USER=resova-alerts@example.com       # [restart] placeholder - dedicated mailbox, never the platform account
IMAP_PASSWORD=CHANGE_ME_PLACEHOLDER       # [restart] SECRET - placeholder only

# --- OpenAI (opportunity scoring) ---
ENABLE_AI_ANALYSIS=true                   # [restart] when false no OpenAI key is required
OPENAI_API_KEY=sk-CHANGE_ME_PLACEHOLDER   # [restart] SECRET - placeholder only
OPENAI_MODEL=gpt-4o-mini                  # [restart] placeholder model id, confirmed in Phase 4
DAILY_AI_ANALYSIS_LIMIT=100               # [runtime] cost guard rail

# --- Telegram (notifications) ---
ENABLE_TELEGRAM=true                      # [restart] when false no Telegram token is required
TELEGRAM_BOT_TOKEN=123456:CHANGE_ME       # [restart] SECRET - placeholder only
TELEGRAM_OWNER_ID=0                       # [restart] Telegram User ID of system owner
TELEGRAM_ALLOWED_USER_ID=0                # [restart] single-user bot / legacy fallback

# --- Listing Poller (public listings, disabled by default) ---
ENABLE_LISTING_POLLER=false               # [restart] master switch
LISTING_POLLER_ACK=false                  # [restart] risk acknowledgement (must be true when poller is enabled)
MOSTAQL_LISTING_URLS=https://mostaql.com/projects
KHAMSAT_LISTING_URLS=https://khamsat.com/community/requests
LISTING_POLL_INTERVAL_SECONDS=60          # [restart] interval in seconds (>= 60s)
LISTING_POLL_JITTER_SECONDS=10            # [restart] jitter in seconds
USER_AGENT_CONTACT=user@example.com       # [restart] contact email in User-Agent header

# NOTE: match thresholds (min_match_score, score bands) live in config/profile.yaml,
# not here, so there is a single source of truth.

# --- Secrets (never commit) ---
.env
.env.*
!.env.example

# --- Virtualenv ---
.venv/

# --- Python bytecode ---
__pycache__/
*.py[cod]

# --- Local databases (never commit) ---
*.db
*.db-wal
*.db-shm
*.sqlite*

# --- Tooling caches and coverage ---
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage

# --- Logs ---
logs/
*.log

# --- Build artifacts / editable install metadata ---
build/
dist/
*.egg-info/
